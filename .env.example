# ReconPilot database
RECONPILOT_DB_PATH=data/reconpilot.db

# AI execution modes:
# local = reproducible offline evaluator (NOT an LLM)
# live  = real LiteLLM/provider investigation
# off   = disable AI and abstain on ambiguous cases
RECONPILOT_AI_MODE=live

# LiteLLM model used in live mode. Examples:
# gpt-4o-mini
# groq/llama-3.3-70b-versatile
LITELLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Matching policy
DETERMINISTIC_CONFIDENCE_MIN=0.95
AI_CONFIDENCE_MIN=0.75
FEE_RATE=0.02
DATE_WINDOW_DAYS=3
